# Copy to `.env` for local development. All variables can also be set directly
# in the process environment (that is how production should run).

# --- required ---
# PostgreSQL + PostGIS connection string.
DATABASE_URL=postgres://kadi:kadi@127.0.0.1:5432/kadi_atlas

# --- HTTP server ---
KADI_ATLAS__BIND_ADDR=127.0.0.1:8080
KADI_ATLAS__REQUEST_TIMEOUT_SECS=30

# --- database pool ---
KADI_ATLAS__DATABASE_MAX_CONNECTIONS=10
KADI_ATLAS__DATABASE_ACQUIRE_TIMEOUT_SECS=10

# Run embedded migrations on startup (server + importer). Set to false in
# environments where the API role is not allowed to run DDL.
KADI_ATLAS__AUTO_MIGRATE=true

# --- pagination ---
KADI_ATLAS__DEFAULT_PAGE_SIZE=50
KADI_ATLAS__MAX_PAGE_SIZE=200

# --- logging ---
# pretty | json
KADI_ATLAS__LOG_FORMAT=pretty
RUST_LOG=info,kadi_atlas=info,tower_http=info,sqlx=warn

# --- CORS (optional) ---
# The API is same-origin by default. Set a single explicit origin to enable a
# read-only (GET/HEAD) CORS policy.
# KADI_ATLAS__CORS_ALLOW_ORIGIN=https://kadi-atlas.example.org
